# LLM: ollama (local) | commandcode (headless CLI) | mock (khong can model)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Thu thap
USER_AGENT=NewsDigestAgent/1.0 (+mailto:you@example.com)
REQUEST_TIMEOUT=20
MAX_ARTICLES_PER_SOURCE=15
MAX_DOCUMENT_MB=10
MAX_DOCUMENTS_PER_ARTICLE=3

# Duong dan du lieu
DATA_DIR=data

# Lark Base
LARK_APP_ID=
LARK_APP_SECRET=
LARK_APP_TOKEN=
LARK_TABLE_ID=
LARK_BASE_URL=https://open.larksuite.com

# true = chi ghi ra data/outbox, khong goi API Lark / khong dang bai / khong gui canh bao
DRY_RUN=true

# Canh bao loi (Error Workflow) - de trong = ghi ra data/outbox/alerts-*.jsonl
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_LARK_WEBHOOK=
# so luot loi lien tiep cua mot nguon truoc khi canh bao
ALERT_SOURCE_FAILURES=2

# Khu trung lap ngu nghia (gom bai cung tin)
SEMANTIC_DEDUP=true
# hash = khong can model | ollama = dung SEMANTIC_MODEL qua /api/embed
SEMANTIC_EMBEDDER=hash
SEMANTIC_MODEL=nomic-embed-text
SEMANTIC_THRESHOLD=0.45
SEMANTIC_WINDOW_HOURS=72

# Phat tan - kenh nao thieu khoa thi chay dry-run
PUBLISH_REQUIRE_APPROVAL=facebook,twitter
PUBLISH_TELEGRAM_BOT_TOKEN=
PUBLISH_TELEGRAM_CHAT_ID=
PUBLISH_LARK_CHAT_ID=
PUBLISH_FACEBOOK_PAGE_ID=
PUBLISH_FACEBOOK_PAGE_TOKEN=
# OAuth 2.0 user-context token co quyen tweet.write
PUBLISH_X_USER_TOKEN=
