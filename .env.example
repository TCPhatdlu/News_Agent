# LLM: ollama (local) | commandcode (headless CLI) | mock (khong can model)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Thu thap
USER_AGENT=NewsDigestAgent/1.0 (+mailto:you@example.com)
REQUEST_TIMEOUT=20
MAX_ARTICLES_PER_SOURCE=15
MAX_DOCUMENT_MB=10
MAX_DOCUMENTS_PER_ARTICLE=3

# Duong dan du lieu
DATA_DIR=data

# Lark Base
LARK_APP_ID=
LARK_APP_SECRET=
LARK_APP_TOKEN=
LARK_TABLE_ID=
LARK_BASE_URL=https://open.larksuite.com

# true = chi ghi ra data/outbox, khong goi API Lark
DRY_RUN=true
